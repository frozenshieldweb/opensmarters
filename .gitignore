# Unpacked vendor code (copyrighted; local reference only)
_reference/

# Build output
/target/
**/*.rs.bk

# Native deps and generated media (fetched/generated locally, never committed)
/vendor/libmpv/
/testdata/generated/
*.ts
*.m3u8
!crates/**/tests/fixtures/**/*.m3u8
*.mp4
*.mkv

# Local app data / logs
*.log
.env

# Agent worktrees
.claude/

# Release output
/dist/

# Launch-asset pipeline: Codex candidates and build scratch (tools/assets/README.md)
/tools/assets/raw/
/tools/assets/.build/
__pycache__/

# Private reverse-engineering notes (not published; see docs/BUILD_PROMPT.md)
/docs/REVERSE_ENGINEERING.md

# Web UI (web/): dependencies, build output and the mock's generated test media
/web/node_modules/
/web/dist/
/web/.media/
# web/ is TypeScript: the *.ts rule above is for MPEG-TS media
!/web/**/*.ts
