# Generated by site/scripts/build.mjs. Hosts that can't set headers (GitHub Pages) get
# the <meta> policy in index.html, which can't carry frame-ancestors.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
